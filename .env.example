# App
APP_NAME = PHP2-BASE
APP_URL = http://localhost/dant_bongda

# VNPay sandbox credentials: replace with the merchant credentials from VNPay.
VNPAY_TMN_CODE =
VNPAY_HASH_SECRET =
VNPAY_URL = https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Optional. Defaults to the VNPay sandbox refund API when VNPAY_URL uses sandbox.
VNPAY_REFUND_URL = https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# This URL must be publicly reachable by the customer's browser.
VNPAY_RETURN_URL = http://localhost/dant_bongda/bookings/vnpay-return
# Configure VNPay IPN URL in the merchant portal:
# http://localhost/dant_bongda/bookings/vnpay-ipn

# Database
DB_DRIVER = pdo_mysql
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_USERNAME = root
DB_PASSWORD =
DB_NAME = db_football_field_booking
